<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRegistration"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftarkan Suara"
        android:textColor="#1B1F3B"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Supaya Yupi hanya menghitung kata dari suara Anda."
        android:textColor="#2F3A5C"
        android:textSize="14sp" />

    <!-- Kartu utama (kaca) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_mic_circle"
            android:gravity="center"
            android:text="🎙"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/tvRegistrationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Belum melakukan registrasi suara"
            android:textColor="#1B1F3B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRecordVoice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="Mulai Rekam"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tips (kaca) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="TIPS"
            android:textColor="#4A5578"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="• Bicara terus selama rekaman, tanpa jeda di awal.\n• Gunakan suara dan jarak seperti biasa.\n• Ulangi pendaftaran kalau hasilnya sering meleset."
            android:textColor="#1B1F3B"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>